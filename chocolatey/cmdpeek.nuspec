<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>cmdpeek</id>
    <version>0.2.0</version>
    <title>cmdpeek</title>
    <authors>cmdpeek contributors</authors>
    <owners>cmdpeek</owners>
    <licenseUrl>https://opensource.org/licenses/MIT</licenseUrl>
    <projectUrl>https://github.com/cmdpeek/cmdpeek</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Show the most recently installed CLI commands, match tasks to tools you already have, and attach usage examples.</description>
    <summary>Recently installed commands + how to use them.</summary>
    <tags>cli powershell scoop winget chocolatey packages</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="..\src\**" target="tools\cmdpeek" />
    <file src="..\examples\**" target="tools\cmdpeek\examples" />
  </files>
</package>
